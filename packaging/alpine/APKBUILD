# Maintainer: Moonstone Team <dev@moonstone.sh>
pkgname=moonstone
pkgver=0.3.24
pkgrel=0
pkgdesc="Deterministic Lua runtime & environment manager"
url="https://moonstone.sh"
arch="all"
license="MIT"
makedepends="zig"
source="$pkgname-$pkgver.tar.gz::https://github.com/moonstone-sh/moonstone/archive/refs/tags/v$pkgver.tar.gz"

build() {
	zig build -Doptimize=ReleaseSafe -Ddistribution-channel=alpine
}

package() {
	install -Dm755 zig-out/bin/moon "$pkgdir"/usr/bin/moon
}
