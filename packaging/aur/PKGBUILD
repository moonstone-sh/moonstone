pkgname=moonstone-bin
pkgver=0.3.24
pkgrel=1
pkgdesc="Deterministic Lua runtime & environment manager"
arch=('x86_64' 'aarch64')
url="https://moonstone.sh"
license=('MIT')
provides=('moonstone')
conflicts=('moonstone')
source_x86_64=("https://github.com/moonstone-sh/moonstone/releases/download/v${pkgver}/moon-x86_64-linux.tar.gz")
source_aarch64=("https://github.com/moonstone-sh/moonstone/releases/download/v${pkgver}/moon-aarch64-linux.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    install -Dm755 "${srcdir}/moon" "${pkgdir}/usr/bin/moon"
}
