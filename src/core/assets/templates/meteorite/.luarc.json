{
  "workspace": {
    "library": [
      ".moonstone/env/share/lua/{{lua_ver}}",
      ".moonstone/env/libexec/meteorite/src",
      ".meteorite/aids/lua"
    ],
    "checkThirdParty": false,
    "useGitIgnore": false,
    "ignoreDir": [
      ".moonstone/env/bin",
      ".moonstone/env/lib",
      ".moonstone/env/include",
      "zig-cache",
      "zig-out",
      ".meteorite/graph",
      "dist",
      ".git"
    ]
  },
  "runtime": {
    "version": "Lua {{lua_ver}}"
  },
  "diagnostics": {
    "disable": [
      "lowercase-global"
    ]
  }
}
