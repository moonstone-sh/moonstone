{
  "name": "@moonstone/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./manifest": "./typescript/manifest.ts",
    "./lock": "./typescript/lock.ts"
  },
  "scripts": {
    "check": "bun x tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler typescript/*.ts tests/*.ts",
