{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moonstone.sh/contracts/manifest-edit/v1/schema.json",
  "title": "Moonstone Manifest Edit v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "expected_revision", "operations"],
  "properties": {
    "contract": { "const": "moonstone:manifest-edit:v1" },
    "expected_revision": { "type": "string", "pattern": "^b3:[0-9a-f]{64}$" },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } }
  },
  "$defs": {
    "setScript": { "type": "object", "additionalProperties": false, "required": ["kind", "name", "command"], "properties": { "kind": { "const": "set_script" }, "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }, "command": { "type": "string", "minLength": 1 } } },
    "removeScript": { "type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": { "kind": { "const": "remove_script" }, "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" } } },
    "operation": { "oneOf": [ { "$ref": "#/$defs/setScript" }, { "$ref": "#/$defs/removeScript" } ] }
  }
}
