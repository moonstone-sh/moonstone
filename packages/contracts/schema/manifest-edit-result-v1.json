{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moonstone.sh/contracts/manifest-edit-result/v1/schema.json",
  "title": "Moonstone Manifest Edit Result v1",
  "x-lua-name": "MoonstoneManifestEditResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "storage_revision", "applied", "storage_mode"],
  "properties": {
    "contract": { "const": "moonstone:manifest-edit-result:v1" },
    "storage_revision": { "type": "string", "pattern": "^b3:[0-9a-f]{64}$" },
    "applied": { "type": "integer", "minimum": 0 },
    "storage_mode": { "enum": ["source_preserving", "canonicalized"] }
  }
}
